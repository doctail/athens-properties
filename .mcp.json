{
  "mcpServers": {
    "nanobanana-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "github:charlesdove977/nanobanana-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GEMINI_MODEL": "${GEMINI_MODEL:-gemini-3.1-flash-image-preview}"
      }
    },
    "nodum": {
      "type": "http",
      "url": "https://nodum.md/api/v1/mcp",
      "headers": {
        "Authorization": "Bearer proxy-injected"
      }
    }
  }
}
